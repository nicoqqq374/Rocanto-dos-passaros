<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Anti-SEO Spam Japones: Retornar 410 Gone de inmediato a Google
  RewriteRule ^(item|shop|detail|goodscode|info|products|produtos|cart|checkout)/.*$ - [G,L]

  # Redireccion de URLs legitimas antiguas para conservar trafico y SEO
  RewriteRule ^index\.php/quartos$ /#acomodacoes [R=301,L,NE]
  RewriteRule ^quartos$ /#acomodacoes [R=301,L,NE]
  RewriteRule ^index\.php$ / [R=301,L]

  # Redireccion de paginas de error
  ErrorDocument 404 /404.html
  ErrorDocument 410 /404.html

  # Rutas limpias para archivos HTML si existen
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# Compresion Gzip para maximo rendimiento en cPanel
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache del navegador para recursos estaticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
