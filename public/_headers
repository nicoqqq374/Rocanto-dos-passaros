# Cloudflare Pages & Workers Edge Security & Cache Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Access-Control-Allow-Origin: *

# Immutable caching for all compiled Next.js assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Immutable caching for all static photography, media and background videos
/recanto/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/rooms/*
  Cache-Control: public, max-age=31536000, immutable

/experience/*
  Cache-Control: public, max-age=31536000, immutable

/gallery/*
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# Fresh HTML delivery with immediate deployment reflection
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Anti-SEO Spam Defense: Instruct search engines to never index or archive spam/error routes
/item/*
  X-Robots-Tag: noindex, nofollow, noarchive

/shop/*
  X-Robots-Tag: noindex, nofollow, noarchive

/detail/*
  X-Robots-Tag: noindex, nofollow, noarchive

/goodscode/*
  X-Robots-Tag: noindex, nofollow, noarchive

/info/*
  X-Robots-Tag: noindex, nofollow, noarchive

/404.html
  X-Robots-Tag: noindex, nofollow
